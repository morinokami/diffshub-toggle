{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "chrome": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "overrides": [
    {
      "files": ["scripts/**", "test/**"],
      "env": { "node": true }
    }
  ]
}
