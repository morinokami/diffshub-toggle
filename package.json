{
  "name": "diffshub-toggle",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome extension that toggles between matching GitHub and DiffsHub pages.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "sh scripts/build.sh",
    "build:icons": "node scripts/generate-icons.js"
  },
  "devDependencies": {
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.4.7",
      "onFail": "warn"
    }
  }
}
